{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ПР9: запустить приложение",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "zapusk.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ПР9: остановить приложение",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "skripty\\ostanovit.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ПР9: запустить тесты",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "skripty\\zapustit_testy.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "ПР9: показать коллекцию pickups",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["skripty\\posmotret_bd.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ПР9: показать запись в MongoDB",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["skripty\\proverit_bd.py", "${input:pickupId}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "pickupId",
      "type": "promptString",
      "description": "pickup_id (например, P-96601D56)",
      "default": "P-96601D56"
    }
  ]
}
